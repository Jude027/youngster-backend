{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js":          { "maxDuration": 60 },
    "api/proxy-datamart.js": { "maxDuration": 15 },
    "api/proxy-datahub.js":  { "maxDuration": 20 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
